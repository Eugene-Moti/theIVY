# Copy to .env.local and fill in. Also set these in Vercel → Project →
# Settings → Environment Variables for production/preview.

# --- Supabase (admin panel auth + leads/listings storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (lead notifications, via Resend) ---
RESEND_API_KEY=

# --- Ivy Group CRM webhook (optional — leads still save/email without it) ---
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Chat assistant (optional — the live ChatWidget uses a local keyword
#     KB and does not need this; only the unused /api/chat route does) ---
GEMINI_API_KEY=

# --- Google Ads conversion tracking ---
# From the Ads account: Goals → Conversions → (each action) → tag setup →
# "Use Google Tag Manager" / per-event snippet. NEXT_PUBLIC_GOOGLE_ADS_ID is
# the account-level ID (e.g. AW-123456789); each LABEL is the id/label
# suffix for that specific conversion action. All four are optional — until
# they're set, forms/WhatsApp/phone clicks still fire plain GA4 events
# (src/lib/analytics.ts), just not Ads conversions.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GADS_LABEL_LEAD=
NEXT_PUBLIC_GADS_LABEL_WHATSAPP=
NEXT_PUBLIC_GADS_LABEL_CALL=
